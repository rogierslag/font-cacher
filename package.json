{
  "name": "font-cacher",
  "version": "2.0.0",
  "main": "src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prettify": "yarn prettier --write '**.js'",
    "format:check": "prettier --check 'src/**/*.js' 'tests/**/*.js' '.github/**/*.yml' package.json",
    "syntax:check": "for file in src/*.js tests/*.js; do node --check \"$file\" || exit; done",
    "check": "yarn format:check && yarn syntax:check && yarn test",
    "test": "node tests/index.js"
  },
  "author": "Rogier Slag <rogier.slag@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "consul": "^2.0.1",
    "koa": "^3.2.1",
    "koa-route": "^4.0.1",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  },
  "resolutions": {
    "consul/uuid": "^11.1.1",
    "koa-route/debug": "^4.4.3"
  }
}
